# Normalise line endings; the build runs on Windows but CI runs on Linux.
* text=auto eol=lf

# --- Explicitly text ------------------------------------------------------
*.c        text
*.h        text
*.cpp      text
*.hpp      text
*.md       text
*.txt      text
*.yml      text
*.yaml     text
*.json     text
sdkconfig.defaults        text
sdkconfig.defaults.*      text
Kconfig*   text
CMakeLists.txt            text
*.cmake    text
.gitignore                text

# --- Explicitly binary ---------------------------------------------------
*.bin      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.bmp      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.pdf      binary
*.zip      binary

# SVG is text and diffs usefully.
*.svg      text eol=lf

# --- Windows scripts want CRLF ------------------------------------------
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# --- Keep generated firmware out of diffs and language stats -------------
firmware/**/*.bin  binary -diff
