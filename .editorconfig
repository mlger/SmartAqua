# EditorConfig — https://editorconfig.org
# Applies to editors that honour it; .clang-format governs C/C++ formatting.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2

[*.{cmake,txt}]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
